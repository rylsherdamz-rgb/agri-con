generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Farmer {
  id           String    @id
  fullName     String    @map("full_name")
  farmName     String    @map("farm_name")
  region       String
  totalYieldKg Int       @map("total_yield_kg")
  idDocPath    String?   @map("id_doc_path")
  verified     Boolean   @default(false)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  listings     Listing[]
  @@map("farmers")
}

model Listing {
  id           Int      @id @default(autoincrement())
  nftId        Int      @unique @map("nft_id")
  cropType     String?  @map("crop_type")
  quantityKg   Int?     @map("quantity_kg")
  priceUsdc    Float?   @map("price_usdc")
  farmerId     String   @map("farmer_id")
  farmer       Farmer   @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  parcelName   String?  @map("parcel_name")
  region       String?
  buyable      Boolean  @default(false)
  ndviBps      Int?     @map("ndvi_bps")
  minNdviBps   Int?     @map("min_ndvi_bps")
  areaHa       Float?   @map("area_ha")
  totalYieldKg Int?     @map("total_yield_kg")
  status       String   @default("minted")
  txHash       String?  @map("tx_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  orders       Order[]
  @@map("listings")
}

model Order {
  id           String   @id @default(uuid())
  listingId    Int      @map("listing_id")
  listing      Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerAddress String   @map("buyer_address")
  amountUsdc   Float    @map("amount_usdc")
  txHash       String?  @map("tx_hash")
  status       String   @default("escrow")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  @@map("orders")
}

model Attestation {
  id          Int      @id @default(autoincrement())
  nftId       Int      @map("nft_id")
  observedAt  DateTime @map("observed_at")
  ndviBps     Int      @map("ndvi_bps")
  minNdviBps  Int      @map("min_ndvi_bps")
  buyable     Boolean
  bboxHash    String   @map("bbox_hash")
  reportHash  String   @map("report_hash")
  source      String
  createdAt   DateTime @default(now()) @map("created_at")
  @@unique([nftId, observedAt])
  @@map("attestations")
}